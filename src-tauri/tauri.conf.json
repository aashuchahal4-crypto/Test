{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Video Studio",
  "version": "0.1.0",
  "identifier": "ai.capy.local-video-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local AI Video Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../core", "../storage/assets", "../docs"]
  }
}
